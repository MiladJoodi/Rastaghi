# Neon Postgres connection string (Dashboard → Connection Details → URI)
# Use the pooled connection for serverless / Next.js on Vercel.
DATABASE_URL=postgresql://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require

# Optional alias used by some Vercel/Neon integrations
# POSTGRES_URL=

# Admin panel (/admin) — set a strong password before deploying
ADMIN_PASSWORD=change-me
# Optional; defaults to ADMIN_PASSWORD if omitted
ADMIN_SECRET=change-me-too

# Cloudinary (Dashboard → Settings → API Keys)
# Used by admin image upload in the post editor
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Optional folder prefix inside your Cloudinary media library
CLOUDINARY_FOLDER=rastaghi
# Optional soft storage ceiling (GiB) for /admin/media chart.
# When unset, Free/credit plans use Cloudinary credits (e.g. 25);
# paid plans use storage.limit from the Usage API.
# CLOUDINARY_STORAGE_LIMIT_GB=25

# Telegram Bot API (contact form notifications on /contact)
# Create a bot via @BotFather, then message the bot once and get chat id
# (e.g. via @userinfobot or getUpdates). Server-only — never expose to client.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
